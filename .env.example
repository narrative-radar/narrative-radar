# Supabase / Postgres
DATABASE_URL="postgresql://postgres:[password]@[host]:5432/[dbname]"

# Embedding API (e.g. OpenAI, Cohere, or similar)
GEMINI_API_KEY="your-embedding-api-key"

# LLM API for cluster labeling (can be same vendor as embedding)
# LABELING_API_KEY="your-labeling-api-key"

# Cron protection — shared secret, must match what your scheduler sends
CRON_SECRET="a-long-random-secret-string"

# Public URL — used in share card links
PUBLIC_APP_URL="http://localhost:5173"

# Pump.fun data source (some providers don't need a key)
# PUMPFUN_API_KEY="your-pumpfun-api-key"

X_API_KEY=""
X_API_SECRET=""
X_ACCESS_TOKEN=""
X_ACCESS_SECRET=""
